{
  "manifest_version": 3,
  "name": "SYSU 抢课 Cookie 同步",
  "version": "1.0.0",
  "description": "把教务系统登录态自动同步到 SYSU 抢课助手本机服务",
  "permissions": ["cookies", "tabs", "alarms"],
  "host_permissions": [
    "https://jwxt.sysu.edu.cn/*",
    "https://cas.sysu.edu.cn/*",
    "http://127.0.0.1:8124/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SYSU 抢课 Cookie 同步",
    "default_popup": "popup.html"
  }
}

